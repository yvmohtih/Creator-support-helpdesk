NODE_ENV=development

# Frontend
NEXT_PUBLIC_APP_NAME=Creator Support
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Backend
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creator_support
SKIP_DATABASE_CONNECT=false
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_HASH_PEPPER=replace-with-a-long-random-secret

# File storage
STORAGE_PROVIDER=s3
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=creator-support-local
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Monitoring
SENTRY_DSN=
