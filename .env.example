NODE_ENV=development

# Frontend
NEXT_PUBLIC_APP_NAME=Creator Support
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_ADMIN_SESSION_COOKIE_NAME=admin_session

# Backend
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creator_support
SKIP_DATABASE_CONNECT=false
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_HASH_PEPPER=replace-with-a-long-random-secret
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=600000
PUBLIC_SUBMIT_MAX_ATTEMPTS=8
PUBLIC_SUBMIT_WINDOW_MS=600000

# Optional local admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=System Admin
ADMIN_ROLE=admin

# File storage
STORAGE_PROVIDER=s3
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=creator-support-local
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Monitoring
SENTRY_DSN=
